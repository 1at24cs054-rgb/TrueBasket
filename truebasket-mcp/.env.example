# TrueBasket MCP Server Configuration

# URL of the running TrueBasket FastAPI backend
TRUEBASKET_API_BASE_URL=http://127.0.0.1:8000

# MCP Server Binding
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Transport: "streamable-http" (for remote/HTTP clients) or "stdio" (for local CLI/Claude Desktop)
MCP_TRANSPORT=streamable-http

# HTTP Endpoint path when running streamable-http transport
MCP_STREAMABLE_HTTP_PATH=/mcp

# Optional authentication token for remote deployments (Bearer token authentication)
# When set, any HTTP request must include Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=

# Request timeout for calls to TrueBasket backend in seconds
BACKEND_TIMEOUT_SECONDS=180

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
