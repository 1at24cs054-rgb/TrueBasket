# ==============================================================================
# TrueBasket Backend — Environment Configuration (.env)
# Copy this file to .env and populate the required API keys and settings.
# Never commit real credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (comma-separated allowed origins for frontend clients)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Tavily Search API Configuration
# Get an API key at: https://tavily.com/
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=15.0
TAVILY_MAX_RESULTS_DEFAULT=5
TAVILY_MAX_RESULTS_LIMIT=10

# ------------------------------------------------------------------------------
# Vision Provider Selection
# "google" = Gemma 4 through the Gemini API (google-genai SDK) — required for the hackathon.
# "openrouter" = optional fallback for local development only.
# ------------------------------------------------------------------------------
AI_VISION_PROVIDER=google

# OpenRouter Configuration (optional fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Gemma 4 LLM & Multimodal Configuration
#
# Supported providers:
# 1. "google" (Official Google Developer API / Google AI Studio)
#    - GEMMA_API_KEY: Your Google AI Studio API key (https://aistudio.google.com/)
#    - GEMMA_MODEL: e.g. gemma-4-26b-a4b-it, gemma-4-12b-it, gemma-4-31b-it, gemma-2-9b-it
#
# 2. "openai_compatible" (Self-hosted or cloud-hosted OpenAI format: vLLM, Ollama, AWS Bedrock proxy)
#    - GEMMA_API_BASE_URL: e.g. http://localhost:11434/v1 or https://your-endpoint.amazonaws.com/v1
#    - GEMMA_API_KEY: Optional bearer token if required by endpoint
#    - GEMMA_MODEL: Model name identifier on your server (e.g. gemma-4-12b)
# ------------------------------------------------------------------------------
GEMMA_PROVIDER=google
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_API_BASE_URL=
GEMMA_TIMEOUT_SECONDS=30.0
GEMMA_TEMPERATURE=0.2
GEMMA_MAX_OUTPUT_TOKENS=1024

