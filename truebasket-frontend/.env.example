# ---------------------------------------------------------------
# TrueBasket works out of the box with NO variables set:
# product data comes from Open Food Facts and community prices
# from Open Prices, both free and keyless.
# ---------------------------------------------------------------

# Optional: Gemma 4 label-reading backend (FastAPI). Enables
# "Read the label with Gemma 4" on the Scan page.
# VITE_API_URL=http://localhost:8000

# Optional: your live price service (partner/affiliate feed).
# Enables the "Live prices" section on Where to buy.
# VITE_PRICE_API_URL=http://localhost:8000

# Optional overrides (defaults shown).
# VITE_OFF_BASE_URL=https://world.openfoodfacts.org
# VITE_OPEN_PRICES_URL=https://prices.openfoodfacts.org
# VITE_API_TIMEOUT_MS=90000

# NEVER put API keys, Gemma/inference credentials or retailer
# credentials here. Every VITE_* value is public in the browser.
